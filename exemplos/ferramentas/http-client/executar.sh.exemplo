#!/bin/sh
# Exemplo de invólucro. Renomeie para executar.sh, copie para dados/ferramentas/http-client/ e rode chmod 755.
# Requer que o curl exista dentro do contêiner do executor (ex.: EXECUTOR_EXTRA_APT=curl no .env, depois
# docker compose build executor) — ou substitua este arquivo por um binário estático do curl.
# O hash SHA-256 registrado na habilitação é o DESTE arquivo; o binário chamado por ele não é verificado.
exec /usr/bin/curl "$@"
