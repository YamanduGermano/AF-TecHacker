{
  "id": "http-client",
  "versao": "1.0.0",
  "nome": "Cliente HTTP (curl)",
  "executavel": "./bin/curl",
  "perfil": "http_client_curl",
  "descricao_modelo": "Envia uma requisição HTTP ao alvo da sessão e devolve status, cabeçalhos e corpo da resposta, sem seguir redirecionamentos.",
  "documentacao": "nmap-manual.md",
  "limites": { "timeout_s": 20, "max_saida_bytes": 1048576, "max_corpo_bytes": 65536 },
  "politica_escopo": {
    "metodos": ["GET", "HEAD"],
    "cabecalhos_permitidos": ["Accept", "Accept-Language", "User-Agent", "Cache-Control"],
    "permitir_corpo": false
  }
}
